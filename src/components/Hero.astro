---
import { Image } from 'astro:assets';
import RotatingWord from './RotatingWord.vue';
import alexPhoto from '../assets/alex.png';
---

<section id="top" class="mx-auto max-w-5xl px-6 pb-14 pt-10 sm:pb-16 sm:pt-14">
  <div class="grid items-center gap-10 sm:grid-cols-[1fr_auto]">
    <div class="order-2 sm:order-1">
      <div class="mb-8 flex items-center gap-2 font-mono text-xs text-[var(--color-muted)]">
        <span class="live-dot inline-block h-2 w-2 rounded-full bg-[var(--color-live)]"></span>
        disponible para proyectos nuevos
      </div>

      <h1 class="max-w-2xl text-4xl leading-[1.15] font-medium tracking-tight text-[var(--color-text)] sm:text-5xl">
        Alex Aranda construye
        <RotatingWord client:load words={['software', 'sistemas web', 'apps móviles', 'marketplaces']} />
        para negocios reales.
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-muted)]">
        Ingeniero en desarrollo de software. Diseño y mantengo marketplaces,
        sistemas administrativos y apps móviles de principio a fin — desde el
        esquema de base de datos hasta la interfaz que usa el cliente final.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-sm text-[var(--color-muted)]">
        <a
          href="https://github.com/tu-usuario"
          class="border-b border-transparent text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          github
        </a>
        <a
          href="https://www.linkedin.com/in/alejandro-hernandez-aranda/"
          class="border-b border-transparent text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          linkedin
        </a>
        <a
          href="https://wa.me/525536659768"
          class="border-b border-transparent text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          whatsapp
        </a>
        <a
          href="/cv-alex-aranda.pdf"
          target="_blank"
          class="border-b border-transparent text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          cv.pdf
        </a>
      </div>
    </div>

    <div class="order-1 justify-self-center sm:order-2 sm:justify-self-end">
      <div class="group relative">
        <div
          class="absolute -inset-1 rounded-full bg-[var(--color-accent)] opacity-0 blur-xl transition-opacity duration-500 group-hover:opacity-20"
        >
        </div>
        <Image
          src={alexPhoto}
          alt="Foto de Alex Aranda"
          width={176}
          height={176}
          class="relative h-32 w-32 rounded-full border border-[var(--color-line)] object-cover grayscale transition-all duration-500 group-hover:grayscale-0 sm:h-44 sm:w-44"
        />
      </div>
    </div>
  </div>
</section>
