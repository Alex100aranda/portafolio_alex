---
import ContactForm from './ContactForm.vue';
---

<section id="contacto" class="mx-auto max-w-5xl px-6 py-14">
  <div class="grid gap-10 sm:grid-cols-[1fr_1.2fr]">
    <div data-reveal>
      <h2 class="text-2xl font-medium text-[var(--color-text)]">Hablemos</h2>
      <p class="mt-4 leading-relaxed text-[var(--color-muted)]">
        Si tienes un proyecto que necesita un sistema hecho a la medida —o
        alguien que se haga cargo de uno que ya existe— este es el lugar para
        empezar.
      </p>
      <p class="mt-4 font-mono text-sm text-[var(--color-muted)]">
        Disponible para trabajo remoto
      </p>
    </div>

    <div data-reveal>
      <ContactForm client:visible />
    </div>
  </div>
</section>
