---
const links = [
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#stack', label: 'Stack' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-40 border-b border-[var(--color-line)] bg-[var(--color-base)]/90 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="#top" class="font-mono text-sm text-[var(--color-text)]">
      alex<span class="text-[var(--color-accent)]">.</span>aranda
    </a>
    <ul class="flex items-center gap-6">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
